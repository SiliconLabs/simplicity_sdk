id: "simplicity_sdk"
label: "Simplicity SDK Suite"
description: |-
  Simplicity SDK Suite for EFM32 and EFR32 microcontrollers and radios.
sdk_version: "2025.6.1"
specification_version: 12
supplier: "Silicon Laboratories, Inc."
component_path:
  - path: "app/bluetooth/component"
  - path: "app/btmesh/component"
  - path: "app/rail/component"
  - path: "app/connect/component"
  - path: "app/wisun/component"
  - path: "app/internal/mcu_cli"
  - path: "app/internal/security_cli"
  - path: "app/internal/component"
  - path: "app/common/component"
  - path: "app/micrium_os_example/component"
