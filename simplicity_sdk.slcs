  - path: "platform/service/component/upgrade.slcu"
  - path: "protocol/bluetooth/component/upgrade.slcu"
  - path: "protocol/flex/component/upgrade.slcu"
  - path: "protocol/zigbee/component/upgrade.slcu"
  - path: "platform/security/component/upgrade.slcu"
  - path: "util/third_party/unity_test_framework/component/upgrade.slcu"
  - path: "protocol/openthread/component/upgrade.slcu"
  - path: "protocol/z-wave/component/upgrade.slcu"
post_build_profile:
  - path: "platform/common/postbuild_profile/"
  - path: "app/bluetooth/postbuild_profile"
  - path: "app/btmesh/postbuild_profile"
  - path: "protocol/z-wave/postbuild_profile/"
  - path: "protocol/openthread/postbuild_profile"
