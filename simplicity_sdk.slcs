  - path: "protocol/z-wave/component-internal"
  - path: "protocol/z-wave/component-internal/CommandClasses"
  - path: "protocol/wisun/component"
  - path: "protocol/usb/component"
  - path: "util/plugin/component"
  - path: "util/silicon_labs/silabs_core/component"
  - path: "util/silicon_labs/rtl/component"
  - path: "util/third_party/cmsis/component"
  - path: "util/third_party/coremark/component"
  - path: "util/third_party/crypto_ip/component"
  - path: "util/third_party/freertos/component"
  - path: "util/third_party/printf/component"
  - path: "util/third_party/rv2_framework/component"
  - path: "util/third_party/segger/component"
  - path: "util/third_party/unity/component"
  - path: "util/third_party/unity_test_framework/component"
  - path: "util/third_party/lwip/component"
  - path: "util/third_party/find_my/component"
  - path: "util/third_party/trusted-firmware-m/component"
  - path: "util/third_party/uwb/component"
  - path: "tool/vsrpc-lib/component"
toolchain_mapping: "platform/common/toolchain/toolchains.slct"
documentation:
  - docset: gecko-platform
    version: "5.2.1"
  - docset: mbed-tls
    version: "3.6.2"
  - docset: connect-stack
    version: "4.1.1"
  - docset: mcu-bootloader
    version: "3.1.1"
  - docset: openthread
    version: "2.7.1"
  - docset: rail
    version: "2.19.1"
  - docset: wifi/wf200/rtos
    version: "3.6.2"
  - docset: wisun
    version: "2.7.0"
  - docset: zigbee
    version: "8.2.1"
  - docset: rtl-lib
    version: "10.0.1"
  - docset: bluetooth
    version: "10.1.0"
  - docset: btmesh
    version: "9.0.1"
  - docset: protocol-usb
    version: "1.5.1"
upgrade_manifest:
  - path: "app/common/upgrade.slcu"
  - path: "app/bluetooth/upgrade.slcu"
  - path: "app/btmesh/upgrade.slcu"
  - path: "app/wisun/upgrade.slcu"
  - path: "app/rail/upgrade.slcu"
