# This HAL applies to series 2 and 3 devices.
id: hal_sysrtc
label: SYSRTC
package: platform_core
description: >
  System Real Time Counter (SYSRTC) peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
    sbom:
        license: Zlib
component_root_path: platform/peripheral
source:
  - path: src/sl_hal_sysrtc.c
include:
  - path: inc
    file_list:
      - path: sl_hal_sysrtc.h
      - path: sl_hal_sysrtc_compat.h
      - path: peripheral_sysrtc.h
      - path: peripheral_sysrtc_compat.h
provides:
  - name: hal_sysrtc
requires:
  - name: device
  - name: device_has_sysrtc
  - name: hal_generic_common
  - name: cmsis_core
  - name: enum
  - name: code_classification
template_contribution:
  - name: code_classification_components
    value: hal_sysrtc
define:
  - name: SL_CODE_COMPONENT_HAL_SYSRTC
    value: hal_sysrtc
documentation:
  docset: gecko-platform
  document:
    - page: platform-peripheral-efr32xg23/sysrtc
      condition: [device_sdid_210]
    - page: platform-peripheral-efr32xg24/sysrtc
      condition: [device_sdid_215]
    - page: platform-peripheral-efr32xg25/sysrtc
      condition: [device_sdid_220]
    - page: platform-peripheral-efr32xg28/sysrtc
      condition: [device_sdid_235]
    - page: platform-peripheral-sixg301/sysrtc
      condition: [device_generic_family_sixx301]
