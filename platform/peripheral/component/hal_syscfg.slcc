# This HAL applies to series 2 and 3 devices.
id: hal_syscfg
label: SYSCFG
package: platform_core
description: >
  SYSCFG API
category: Platform|Peripheral|HAL
quality: production
metadata:
    sbom:
        license: Zlib
component_root_path: platform/peripheral

include:
  - path: inc
    file_list:
      - path: sl_hal_syscfg.h

provides:
  - name: hal_syscfg

requires:
  - name: tz_service_syscfg
    condition: [trustzone_nonsecure]
documentation:
  docset: gecko-platform
  document:
    - page: platform-peripheral-efr32xg21/syscfg
      condition: [device_sdid_200]
    - page: platform-peripheral-efr32xg22/syscfg
      condition: [device_sdid_205]
    - page: platform-peripheral-efr32xg23/syscfg
      condition: [device_sdid_210]
    - page: platform-peripheral-efr32xg24/syscfg
      condition: [device_sdid_215]
    - page: platform-peripheral-efr32xg25/syscfg
      condition: [device_sdid_220]
    - page: platform-peripheral-efr32xg26/syscfg
      condition: [device_sdid_225]
    - page: platform-peripheral-efr32xg27/syscfg
      condition: [device_sdid_230]
    - page: platform-peripheral-efr32xg28/syscfg
      condition: [device_sdid_235]
    - page: platform-peripheral-efr32xg29/syscfg
      condition: [device_sdid_240]
    - page: platform-peripheral-sixg301/syscfg
      condition: [device_generic_family_sixx301]