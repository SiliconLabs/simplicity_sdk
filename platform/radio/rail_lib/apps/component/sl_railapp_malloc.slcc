id: sl_railapp_malloc
label: SL RAILAPP Malloc
package: platform
description: Memory allocation component for SL RAILAPP debug buffer capture
category: Platform|Radio
quality: production
metadata:
  sbom:
    license: Zlib
provides:
  - name: sl_railapp_malloc
requires:
  - name: sl_core
config_file:
  - path: platform/radio/rail_lib/apps/sl_rail_app/config/sl_railapp_malloc_config.h
source:
  - path: platform/radio/rail_lib/apps/sl_rail_app/railapp_malloc.c
include:
  - path: platform/radio/rail_lib/apps/sl_rail_app
    file_list:
      - path: railapp_malloc.h
