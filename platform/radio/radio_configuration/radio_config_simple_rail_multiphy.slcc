id: radio_config_simple_rail_multiphy
label: Custom Radio Configuration for simple rail multiphy application
package: platform_default_radio_confs
description: Triggers Radio Configurator UI for setting a proper (Application - Die
  - RF Band) Custom Radio Configurator
category: Platform|Radio Configuration
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: radio_config_simple_rail_multiphy
- name: a_radio_config
  allow_multiple: true
ui_hints:
  visibility: never
template_contribution:
- name: component_catalog
  value: radio_config_simple_rail_multiphy
config_file:
- path: platform/radio/radio_configuration/Base/simple_rail_multiphy/device_generic_family_efr32xg23/rf_band_868/subGHz/rf_band_914/radio_settings.radioconf
  file_id: radio_configuration_settings
  directory: rail
  condition:
  - device_has_radio_subghz
  - device_generic_family_efr32xg23
  unless:
  - device_has_radio_2g4hz
  - device_has_radio_dualband
  - hardware_board_rb
  - hardware_board_tb
  - hardware_board_stk
  - device_is_module
  - device_generic_family_efr32xg21
- path: platform/radio/radio_configuration/Base/simple_rail_multiphy/device_generic_family_efr32xg28/rf_band_868/2p4GHz/radio_settings.radioconf
  file_id: radio_configuration_settings
  directory: rail
  condition:
  - device_has_radio_dualband
  - device_generic_family_efr32xg28
  unless:
  - hardware_board_rb
  - hardware_board_tb
  - hardware_board_stk
  - device_is_module
  - device_generic_family_efr32xg21
- path: platform/radio/radio_configuration/Base/simple_rail_multiphy/device_generic_family_efr32xg23/rf_band_868/subGHz/rf_band_914/radio_settings.radioconf
  file_id: radio_configuration_settings
  directory: rail
  condition:
  - hardware_board_default_rf_band_868
  - device_generic_family_efr32xg23
  - hardware_board_supports_rf_band_914
  unless:
  - device_is_module
  - device_generic_family_efr32xg21
- path: platform/radio/radio_configuration/Base/simple_rail_multiphy/device_generic_family_efr32xg23/rf_band_868/subGHz/rf_band_915/radio_settings.radioconf
  file_id: radio_configuration_settings
  directory: rail
  condition:
  - hardware_board_default_rf_band_868
  - device_generic_family_efr32xg23
  - hardware_board_supports_rf_band_915
  unless:
  - device_is_module
  - device_generic_family_efr32xg21
- path: platform/radio/radio_configuration/Base/simple_rail_multiphy/device_generic_family_efr32xg28/rf_band_868/2p4GHz/radio_settings.radioconf
  file_id: radio_configuration_settings
  directory: rail
  condition:
  - hardware_board_default_rf_band_868
  - device_generic_family_efr32xg28
  - hardware_board_supports_rf_band_2400
  unless:
  - device_is_module
  - device_generic_family_efr32xg21
