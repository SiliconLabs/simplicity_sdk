#include "sl_clock_manager.h"
#include "sl_hal_gpio.h"
#include "sl_i2c.h"

// Include instance config {# Include instance config #}
{% for instance in i2c_instances %}#include "sl_i2c_{{ instance }}_config.h"
{% endfor %}
{% for instance in i2c_instances %}sl_i2c_handle_t sl_i2c_{{instance}}_handle;
{% endfor -%}
{% for instance in i2c_instances %}
#if SL_I2C_{{ instance | upper }}_FREQ_MODE == 0
#define SL_I2C_{{ instance | upper }}_MAX_FREQ      SL_I2C_FREQ_STANDARD_MODE
#elif SL_I2C_{{ instance | upper }}_FREQ_MODE == 1
#define SL_I2C_{{ instance | upper }}_MAX_FREQ      SL_I2C_FREQ_FAST_MODE
#elif SL_I2C_{{ instance | upper }}_FREQ_MODE == 2
#define SL_I2C_{{ instance | upper }}_MAX_FREQ      SL_I2C_FREQ_FASTPLUS_MODE
#endif
{% endfor -%}

{% for instance in i2c_instances %}
#if defined(SL_CATALOG_I2C_FIFO_PRESENT)
sl_i2c_fifo_threshold_level_t fifo_threshold_config = {
  .tx_threshold_val = SL_I2C_{{ instance | upper }}_TX_FIFO_THRESHOLD_VALUE,
  .rx_threshold_val = SL_I2C_{{ instance | upper }}_TX_FIFO_THRESHOLD_VALUE,
};
#endif
{% endfor -%}

{% for instance in i2c_instances %}
sl_i2c_init_params_t init_{{instance}} = { {# create init struct #}
  .i2c_base_addr = SL_I2C_{{ instance | upper }}_PERIPHERAL,
  .operating_mode = SL_I2C_{{ instance | upper }}_OPERATING_MODE,
  .freq_mode = SL_I2C_{{ instance | upper }}_MAX_FREQ,
  .sda_gpio = (sl_gpio_t){.port = SL_I2C_{{ instance | upper }}_SDA_PORT, .pin = SL_I2C_{{ instance | upper }}_SDA_PIN},
  .scl_gpio = (sl_gpio_t){.port = SL_I2C_{{ instance | upper }}_SCL_PORT, .pin = SL_I2C_{{ instance | upper }}_SCL_PIN},
#if defined(SL_CATALOG_I2C_FIFO_PRESENT)
  .fifo_threshold = &fifo_threshold_config,
#endif
};
{% endfor -%}
{# whitespace #}
void sl_i2c_init_instances(void)
{
  sl_status_t status;

  {%- for instance in i2c_instances %}
  // Initialize the I2C driver
  status = sl_i2c_init(&init_{{instance}}, &sl_i2c_{{instance}}_handle);
  EFM_ASSERT(SL_STATUS_OK == status);
  {%- endfor %}
}
