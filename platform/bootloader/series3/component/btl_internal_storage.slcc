id: btl_internal_storage
label: Internal Storage (Series-3)
package: bootloader
description: >
  The Bootloader Internal Storage is a storage component using
  internal flash. With this component included, during upgrade image is stored
  in the internal flash during the upgrade process. DMA channel can be
  configured for DMA-based MSC write.
category: Platform|Bootloader|Storage
quality: production
source:
  - path: platform/bootloader/series3/storage/ext_mem/btl_storage_ext_mem.c
include:
  - path: platform/bootloader/series3
  - path: platform/bootloader/series3/api
    file_list:
      - path: btl_interface.h
      - path: btl_interface_parser.h
  - path: platform/bootloader/series3/storage/ext_mem
    file_list:
      - path: btl_storage_ext_mem.h
  - path: platform/bootloader
  - path: platform/bootloader/api
    file_list:
      - path: application_properties.h
      - path: btl_errorcode.h
      - path: btl_reset_info.h
define:
  - name: BOOTLOADER_SUPPORT_STORAGE
    value: 1
provides:
  - name: btl_internal_storage
metadata:
  sbom:
    license: MSLA