id: mbedtls_jpake
package: security_mbedtls
label: J-PAKE over Elliptic Curves
description: >-
  This component provides support for Elliptic Curve (EC) J-PAKE using Mbed TLS.
category: Platform|Security|Mbed TLS|Key Exchange
quality: production
source:
  - path: util/third_party/mbedtls/library/ecjpake.c
    unless: [trustzone_nonsecure]
provides:
  - name: mbedtls_jpake
requires:
  - name: mbedtls_core
  - name: mbedtls_ecc_secp256r1
  - name: mbedtls_sha256
  - name: psa_crypto_jpake
    condition: [psa_crypto]
template_contribution:
  - name: mbedtls_config
    value: MBEDTLS_ECJPAKE_C
  - name: mbedtls_config
    value: MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED
metadata:
  sbom:
    license: Apache-2.0
    upstream:
      name: Mbed TLS
      version: v3.6.2
      supplier: Trusted Firmware
      url: https://github.com/Mbed-TLS/mbedtls.git
      comment: Mbed TLS is a C library implementing the PSA Cryptography API, cryptographic primitives, X.509 certificate manipulation and the SSL/TLS and DTLS protocols
