id: mbedtls_sha256
package: security_mbedtls
label: SHA-224 and SHA-256
description: >-
  This component provides support for SHA-224 and SHA-256 hash functions using Mbed TLS.
category: Platform|Security|Mbed TLS|Hashing
quality: production
source:
  - path: util/third_party/mbedtls/library/sha256.c
    unless: [trustzone_nonsecure]
provides:
  - name: mbedtls_sha256
  - name: mbedtls_hash_function
    allow_multiple: true
  - name: mbedtls_sha_function
    allow_multiple: true
requires:
  - name: mbedtls_hash
  - name: psa_crypto_sha224
    condition: [psa_crypto]
  - name: psa_crypto_sha256
    condition: [psa_crypto]
template_contribution:
  - name: mbedtls_config
    value: MBEDTLS_SHA256_C
  - name: mbedtls_config
    value: MBEDTLS_SHA224_C
metadata:
  sbom:
    license: Apache-2.0
    upstream:
      name: Mbed TLS
      version: v3.6.2
      supplier: Trusted Firmware
      url: https://github.com/Mbed-TLS/mbedtls.git
      comment: Mbed TLS is a C library implementing the PSA Cryptography API, cryptographic primitives, X.509 certificate manipulation and the SSL/TLS and DTLS protocols
