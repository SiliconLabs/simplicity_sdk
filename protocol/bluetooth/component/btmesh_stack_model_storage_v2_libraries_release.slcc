id: btmesh_stack_model_storage_v2_libraries_release
ui_hints:
  visibility: never
package: bluetooth_mesh
description: Libraries for btmesh_stack_model_storage_v2
category: Bluetooth Mesh|Stack
quality: production
provides:
  - name: btmesh_stack_model_storage_v2_libraries_release
  - name: btmesh_stack_model_storage_v2_libraries
library:
  - path: protocol/bluetooth/build/gcc/cortex-m33/mesh_app/release/libbtmesh_model_storage_v2.a
    condition:
      - toolchain_gcc
      - cortexm33
  - path: protocol/bluetooth/build/iar/cortex-m33/mesh_app/release/libbtmesh_model_storage_v2.a
    condition:
      - toolchain_iar
      - cortexm33
metadata:
  sbom:
    reference: btmesh_stack
