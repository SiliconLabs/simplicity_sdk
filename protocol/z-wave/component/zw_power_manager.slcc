id: zw_power_manager
label: Z-Wave Power Manager Component
category: Z-Wave|PowerManager
description: >
  This component provides Power Manager functionalities for application code, that can be used to optimize power consumption of the device. It exposed zw_power_mananger APIs and IDs to the users.
ui_hints:
  visibility: never
package: Z-Wave
quality: production
metadata:
  sbom:
    reference: zw_sbom_license
source:
  - path: "protocol/z-wave/platform/SiliconLabs/components/zw_power_manager/zw_power_manager.c"
include:
  - path: "protocol/z-wave/platform/SiliconLabs/components/zw_power_manager/"
    file_list:
      - path: "zw_power_manager_ids.h"
provides:
  - name: zw_power_manager
template_contribution:
#------------------ Component Catalog ---------------------
  - name: component_catalog
    value: zw_power_manager