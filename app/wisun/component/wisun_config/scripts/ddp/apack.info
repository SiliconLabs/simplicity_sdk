# Wisun DDP Credentials

# Is used for SetupId
id=wisunDdp
path=.,deploy
label=Wi-SUN DDP Credentials

function(init_nvm_ser) {
  cmd=$(python) DDPAdapter.py --soc ${socType} --jlink_ser ${serialNumber} ${command} --prov_img ${prov_img}
}

function(init_nvm_ip) {
  cmd=$(python) DDPAdapter.py --soc ${socType} --jlink_host ${ipAddress} ${command} --prov_img ${prov_img}
}

